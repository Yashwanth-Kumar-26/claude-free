#!/usr/bin/env bash
set -e

# Resolve symlink so DIR always points to the project root
SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
DIR="$(dirname "$SCRIPT")"

# Use .venv python if available (uv sync creates it), otherwise system python
if [ -x "$DIR/.venv/bin/python3" ]; then
    PYTHON="$DIR/.venv/bin/python3"
else
    PYTHON="python3"
fi

cd "$DIR"
exec "$PYTHON" -m cli.entrypoints "$@"
